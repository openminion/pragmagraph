include LICENSE
recursive-include scripts *.py
recursive-include scripts/baselines *.tsv
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests/contracts *.json
recursive-include tests/fixtures *.json *.md *.py *.toml
include API_COMPATIBILITY.md
include README.md
include RELEASING.md
recursive-exclude * __pycache__ *.py[cod]
prune src/*.egg-info
